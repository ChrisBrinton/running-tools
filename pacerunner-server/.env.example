# Server config. There are no shared bearer tokens anymore — auth lives in
# the SQLite `user_tokens` table, populated via the admin CLI:
#
#   npm run admin -- create-user --name "Chris"
#   npm run admin -- create-token --user-id 1 --scope ingest --label "phone"
#   npm run admin -- create-token --user-id 1 --scope mcp --label "claude-code"
#
# The token value is shown once on creation.

PORT=8080
PACERUNNER_DATA_DIR=./data
